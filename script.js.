let character = "";
let chapter = 1;
let previousSection = "home";

const scenes = [
  {
    chapter: "CHAPTER 1 — THE BEGINNING",
    text: "You wake up in an unfamiliar apartment. The streets outside are unusually quiet. Your phone has no signal, and the news reports an emergency outbreak. You need to find a safe place before nightfall. What will you do?",
    choices: [
      {
        text: "Explore the apartment.",
        next: "You search the apartment and discover a backpack containing some useful supplies. You also find a handwritten note from someone who left in a hurry."
      },
      {
        text: "Look outside for survivors.",
        next: "You approach the window. A neighbor notices you and signals that they need help. You have to decide whether to approach them."
      },
      {
        text: "Check the emergency radio.",
        next: "You find an old radio. A distant voice announces that a temporary evacuation center is accepting survivors."
      }
    ]
  },
  {
    chapter: "CHAPTER 2 — THE NEXT MOVE",
    text: "You have gathered your thoughts and need to choose your next destination. The evacuation center might offer safety, but you have also heard that other survivors are gathering nearby.",
    choices: [
      {
        text: "Go to the evacuation center.",
        next: "You reach the evacuation center and meet several survivors. Perhaps this is the beginning of a new journey."
      },
      {
        text: "Find other survivors.",
        next: "You meet a small group of travelers. They offer to help you, but you still need to decide whether you can trust them."
      },
      {
        text: "Search for supplies.",
        next: "You discover an abandoned convenience store. You find food, water, and a map showing a possible safe route."
      }
    ]
  }
];

function showSection(id) {
  document.querySelectorAll("section").forEach(s => {
    s.classList.add("hidden");
  });
  document.getElementById(id).classList.remove("hidden");
}

function goHome() {
  showSection("home");
}

function showCharacters() {
  document.querySelectorAll(".character").forEach(c => {
    c.classList.remove("selected");
  });
  character = "";
  showSection("characters");
}

function selectCharacter(element, name) {
  document.querySelectorAll(".character").forEach(c => {
    c.classList.remove("selected");
  });
  element.classList.add("selected");
  character = name;
}

function beginStory() {
  if (!character) {
    alert("Please select a character first.");
    return;
  }

  chapter = 1;
  displayScene("game", scenes[0].text);
}

function displayScene(section, message) {
  showSection(section);

  document.getElementById("chapter").textContent =
    scenes[chapter - 1].chapter;

  document.getElementById("status").textContent =
    "Survivor: " + character + " | Chapter: " + chapter;

  document.getElementById("storyText").textContent = message;

  const choices = document.getElementById("choices");
  choices.innerHTML = "";

  scenes[chapter - 1].choices.forEach(choice => {
    const button = document.createElement("button");
    button.textContent = choice.text;

    button.onclick = () => {
      if (chapter < scenes.length) {
        chapter++;
        displayScene("game", choice.next);
      } else {
        document.getElementById("storyText").textContent =
          choice.next + " Your journey continues...";
        choices.innerHTML = "";
      }
      saveGame();
    };

    choices.appendChild(button);
  });
}

function saveGame() {
  localStorage.setItem("outbreakSave", JSON.stringify({
    character,
    chapter,
    storyText: document.getElementById("storyText").textContent
  }));

  alert("Game saved successfully!");
  updateContinue();
}

function continueGame() {
  const saved = JSON.parse(localStorage.getItem("outbreakSave"));

  if (saved) {
    character = saved.character;
    chapter = saved.chapter;
    displayScene("game", saved.storyText);
  }
}

function updateContinue() {
  document.getElementById("continueBtn").disabled =
    !localStorage.getItem("outbreakSave");
}

function showHint() {
  previousSection = document.querySelector("section:not(.hidden)").id;
  document.getElementById("hintText").textContent =
    "HINT: Pay attention to your surroundings. Supplies, radio messages, and other survivors may help you find a safe route.";
  showSection("hint");
}

function backFromHint() {
  showSection(previousSection);
}

updateContinue();
    
